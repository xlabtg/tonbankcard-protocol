{
  "name": "@tonbankcard/payment-indexer",
  "version": "1.0.0",
  "description": "Read-only payment status indexer for Tonbankcard Protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node ./scripts/copy-migrations.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "db:migrate": "ts-node scripts/migrate.ts up",
    "db:migrate:status": "ts-node scripts/migrate.ts status",
    "db:migrate:rollback": "ts-node scripts/migrate.ts down",
    "validate": "ts-node scripts/validate.ts",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "indexer",
    "blockchain",
    "read-only",
    "payment-status"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "dependencies": {
    "@ton/core": "0.63.1",
    "@ton/ton": "13.11.2",
    "better-sqlite3": "11.10.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "ioredis": "5.10.1",
    "pino": "8.21.0",
    "pino-pretty": "10.3.1",
    "rate-limiter-flexible": "5.0.5"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/ioredis": "4.28.10",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "@types/pg": "8.20.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.8.3",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "pg": "8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "handlebars": "^4.7.9",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "picomatch": "^2.3.2",
    "ajv": "^6.15.0",
    "form-data": "^4.0.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
