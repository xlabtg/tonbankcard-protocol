{
  "name": "@tonbankcard/payment-indexer",
  "version": "1.0.0",
  "description": "Read-only payment status indexer for Tonbankcard Protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "db:migrate": "node scripts/migrate.js",
    "validate": "ts-node scripts/validate.ts"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "indexer",
    "blockchain",
    "read-only",
    "payment-status"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "dependencies": {
    "@ton/core": "^0.56.0",
    "@ton/ton": "^13.11.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "better-sqlite3": "^9.2.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@jest/globals": "^29.7.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
