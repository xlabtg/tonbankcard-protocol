# Tonbankcard Payment Indexer Configuration

# Node Environment
NODE_ENV=development

# API Server
PORT=3000
HOST=0.0.0.0

# TON Blockchain
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2
TON_API_KEY=

# Contract Addresses (Testnet)
# Note: Replace with actual testnet/mainnet addresses
PAYMENT_HUB_ADDRESS=
MERCHANT_PAYMENT_HUB_ADDRESS=
NFT_COLLECTION_7777_ADDRESS=
NFT_COLLECTION_8888_ADDRESS=

# Database
DB_PATH=./data/indexer.db

# Indexer Settings
INDEXER_START_BLOCK=0
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_BATCH_SIZE=100

# Reorg Protection
INDEXER_CONFIRMATION_BLOCKS=10

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# API Settings
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=100
# Set to true when running behind a reverse proxy (nginx, Cloudflare, etc.)
# so that X-Forwarded-For is trusted for IP extraction.
API_TRUST_PROXY=false
# Number of trusted proxy hops nearest to this service. Defaults to 1 when
# API_TRUST_PROXY=true, otherwise 0.
API_TRUSTED_PROXY_COUNT=0

# Redis (optional) – when REDIS_HOST is set the API uses distributed rate limiting.
# Leave blank to fall back to in-process rate limiting (single-instance only).
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
