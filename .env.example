# =============================================================================
# Tonbankcard Protocol — project-root environment file
# =============================================================================
#
# Copy this file to `.env` in the repository root and adjust values for your
# local environment. The .env file is loaded by docker compose for every
# service; per-service overrides live in api/.env and backend/indexer/.env.
#
# Real secrets MUST NEVER be committed: see .gitignore.

# ---------------------------------------------------------------------------
# Global runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Host port mappings (used by docker-compose.yml)
# ---------------------------------------------------------------------------
# Avoid clashes with other local services by changing these as needed.
API_HOST_PORT=3001
INDEXER_HOST_PORT=3002
REDIS_HOST_PORT=6379
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Redis (shared between API and indexer)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# PostgreSQL (optional, enabled via `--profile postgres`)
# ---------------------------------------------------------------------------
POSTGRES_USER=tonbankcard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tonbankcard
DATABASE_URL=postgres://tonbankcard:change-me@postgres:5432/tonbankcard

# ---------------------------------------------------------------------------
# TON blockchain (forwarded to the indexer)
# ---------------------------------------------------------------------------
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2
# Get a key from https://toncenter.com/ — required for production rate limits.
TON_API_KEY=

# Contract addresses (must be set before the indexer can do anything useful).
PAYMENT_HUB_ADDRESS=
MERCHANT_PAYMENT_HUB_ADDRESS=
NFT_COLLECTION_7777_ADDRESS=
NFT_COLLECTION_8888_ADDRESS=

# ---------------------------------------------------------------------------
# API service overrides
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
API_KEY_SECRET=change-me-to-a-32-byte-random-value
