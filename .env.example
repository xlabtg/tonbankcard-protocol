# =============================================================================
# Tonbankcard Protocol — project-root environment file
# =============================================================================
#
# Copy this file to `.env` in the repository root and adjust values for your
# local environment. The .env file is loaded by docker compose for every
# service; per-service overrides live in api/.env and backend/indexer/.env.
#
# Real secrets MUST NEVER be committed: see .gitignore.

# ---------------------------------------------------------------------------
# Global runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Host port mappings (used by docker-compose.yml)
# ---------------------------------------------------------------------------
# Avoid clashes with other local services by changing these as needed.
# Redis and PostgreSQL are always bound to 127.0.0.1 by docker-compose.yml.
API_HOST_PORT=3001
INDEXER_HOST_PORT=3002
REDIS_HOST_PORT=6379
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Redis (shared between API and indexer)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Required: Redis runs with --requirepass and the stack refuses to start
# without it (audit finding PC-07). Generate a fresh value with
# `openssl rand -hex 32`.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# PostgreSQL (optional, enabled via `--profile postgres`)
# ---------------------------------------------------------------------------
POSTGRES_USER=tonbankcard
# Required before enabling the postgres profile. Generate a fresh value with
# `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=tonbankcard
# Set only when the API should use PostgresStorage instead of InMemoryStorage.
# DATABASE_URL=postgres://tonbankcard:<generated-password>@postgres:5432/tonbankcard

# ---------------------------------------------------------------------------
# TON blockchain (forwarded to the indexer)
# ---------------------------------------------------------------------------
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2
# Get a key from https://toncenter.com/ — required for production rate limits.
TON_API_KEY=

# Contract addresses (must be set before the indexer can do anything useful).
PAYMENT_HUB_ADDRESS=
MERCHANT_PAYMENT_HUB_ADDRESS=
NFT_COLLECTION_7777_ADDRESS=
NFT_COLLECTION_8888_ADDRESS=

# ---------------------------------------------------------------------------
# API service overrides
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
API_KEY_SECRET=change-me-to-a-32-byte-random-value
# HMAC key shared with the trusted settlement indexer; the API rejects any
# settlement event not attested by it (audit finding API-H3). Generate with
# `openssl rand -hex 32`.
SETTLEMENT_INDEXER_SECRET=change-me-to-a-32-byte-random-value
