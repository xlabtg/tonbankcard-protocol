# =============================================================================
# Tonbankcard Protocol — sandbox environment file (testnet only)
# =============================================================================
#
# Copy to `.env.sandbox` and adjust for your sandbox deployment. This file is
# consumed by `docker-compose.sandbox.yml` to bring up the public testnet
# sandbox described in `docs/sandbox.md`.
#
# WARNING: never commit a real .env.sandbox containing secrets. The values
# below are placeholders chosen so that an unmodified sandbox cannot
# accidentally interact with mainnet infrastructure.

# ---------------------------------------------------------------------------
# Networking — sandbox stack is on its own host-port range so it can coexist
# with the standard `docker-compose.yml` dev stack.
# ---------------------------------------------------------------------------
SANDBOX_API_HOST_PORT=3001
SANDBOX_INDEXER_HOST_PORT=3002
SANDBOX_FAUCET_HOST_PORT=4500
SANDBOX_REDIS_HOST_PORT=6380

# CORS origins allowed by the sandbox API + faucet. Set to your sandbox
# dashboard origin in production; defaults match the SDK example dev servers.
SANDBOX_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# ---------------------------------------------------------------------------
# Redis (shared idempotency + rate-limit storage for the API and indexer).
# Always bound to 127.0.0.1 by docker-compose.sandbox.yml.
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Required: Redis runs with --requirepass and the sandbox stack refuses to
# start without it (audit finding PC-07). Generate a fresh value with
# `openssl rand -hex 32`.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# TON network — TESTNET ONLY in the sandbox. Setting mainnet here will cause
# the indexer to refuse to start (see backend/indexer/src/types/config.ts).
# ---------------------------------------------------------------------------
TON_NETWORK=testnet
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2
# Get a key from https://toncenter.com — required for production rate limits.
TON_API_KEY=

# Sandbox contract addresses — must be deployed on testnet first.
PAYMENT_HUB_ADDRESS=
MERCHANT_PAYMENT_HUB_ADDRESS=

# ---------------------------------------------------------------------------
# Sandbox discovery — surfaced by `GET /v1/sandbox/info`.
# ---------------------------------------------------------------------------
SANDBOX_BASE_URL=https://sandbox.api.tonbankcard.com
SANDBOX_FAUCET_URL=https://sandbox.api.tonbankcard.com/faucet
SANDBOX_RESET_CADENCE=weekly
SANDBOX_DEFAULT_MERCHANT_NFT=EQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
SANDBOX_TEST_NFT_CARDS=0:1111111111111111111111111111111111111111111111111111111111111111,0:2222222222222222222222222222222222222222222222222222222222222222

# Used to derive HMAC for API key hashing. Required even for sandbox so stored
# API key hashes are not derived from a public repository value. Generate a
# fresh secret before starting the stack:
#   openssl rand -base64 32
SANDBOX_API_KEY_SECRET=

# ---------------------------------------------------------------------------
# TBC faucet — 1 dispense per address per hour by default.
# ---------------------------------------------------------------------------
FAUCET_DEFAULT_DISPENSE_NANOCOINS=10000000000
FAUCET_RATE_LIMIT_WINDOW_MS=3600000
FAUCET_RATE_LIMIT_MAX=1
