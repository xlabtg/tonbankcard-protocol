{
  "name": "issue-371-paymenthub-create-once",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone reproduction of PC-02 / #371 — PaymentHub.InitializeAccount must be write-once (create-once) so a compromised admin cannot re-initialize and drain a funded account.",
  "scripts": {
    "sync": "node -e \"require('fs').copyFileSync('../../contracts/payments/PaymentHub.tact','PaymentHub.tact')\"",
    "build": "npm run sync && tact --config tact.config.json",
    "test": "jest"
  },
  "license": "MIT",
  "dependencies": {
    "@tact-lang/compiler": "1.4.4",
    "@ton/core": "^0.56.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@ton/sandbox": "^0.16.0",
    "@ton/test-utils": "^0.12.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.repro.spec.ts"
    ],
    "globals": {
      "ts-jest": {
        "isolatedModules": true
      }
    }
  }
}
