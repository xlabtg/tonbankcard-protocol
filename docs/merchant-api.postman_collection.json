              "raw": "{{base_url}}/invoice/{{invoice_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["invoice", "{{invoice_id}}", "status"]
            },
            "description": "Check settlement status and obtain the on-chain verification proof. Requires merchant authentication.\n\nWhen `status` is `settled`, the response carries `settlement.on_chain_verified` and a `verification_url` (TONScan link). The merchant **MUST** re-verify on-chain before granting fulfillment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('payload has expected status enum', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.be.oneOf(['pending', 'settled', 'expired']);",
                  "});"
                ]
              }
            }
