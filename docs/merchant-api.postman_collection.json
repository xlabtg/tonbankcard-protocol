        {
          "name": "Get invoice",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/invoice/{{invoice_id}}",
              "host": ["{{base_url}}"],
              "path": ["invoice", "{{invoice_id}}"]
            },
            "description": "Retrieve full invoice details. Public endpoint — wallets may call it without an API key. Returns settlement metadata once the on-chain `MerchantPayment` event is observed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('invoice id matches collection variable', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.invoice_id).to.eql(pm.collectionVariables.get('invoice_id'));",
                  "});"
                ]
              }
            }
          ],
