{
  "name": "@tonbankcard/payment-hub-account-state",
  "version": "1.0.0",
  "description": "Account State Machine for Tonbankcard Payment Hub",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tact --config tact.config.json",
    "build:wrappers": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "deploy:testnet": "ts-node scripts/deploy.ts --network testnet",
    "deploy:mainnet": "ts-node scripts/deploy.ts --network mainnet",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "smart-contract",
    "tact",
    "payment-hub",
    "account-state",
    "ledger"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "dependencies": {
    "@tact-lang/compiler": "^1.4.4",
    "@ton/core": "^0.56.0",
    "@ton/crypto": "^3.2.0",
    "@ton/ton": "^13.11.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@ton/sandbox": "^0.16.0",
    "@ton/test-utils": "^0.12.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
