;; Public Collateral Status Lookup Contract
;; Part of Tonbankcard Protocol - Issue 6.3
;;
;; NON-PRODUCTION / NOT PRODUCTION READY:
;; has_active_collateral currently returns the privacy-preserving default
;; instead of reading Account Locks state. This source is intentionally excluded
;; from deployable manifests until that integration is implemented.
;;
;; PURPOSE:
;; Provides a PUBLIC, READ-ONLY mechanism to verify whether an NFT-based account
;; has active collateral commitments, WITHOUT exposing any sensitive details.
;;
;; DESIGN PRINCIPLE:
;; "Reveal existence, not details."
;; This contract answers ONLY ONE question:
;; "Does this NFT account currently signal active collateral?"
;;
;; PRIVACY GUARANTEES:
;; - Returns ONLY boolean (true/false)
;; - No collateral amount exposed
;; - No lender identity exposed
;; - No loan terms exposed
;; - No timestamps exposed
;; - No transaction history exposed
;; - No wallet linkages possible
;;
;; PROTOCOL INVARIANTS (see docs/invariants.md):
;; - I6 (Lock != Confiscation): Lookup is informational only, does not enforce restrictions
;; - I7 (Adapter Isolation): External systems cannot modify state via lookup
;;
;; REFERENCE: docs/public-collateral-lookup.md

#include "stdlib.fc";

;; ============================================================================
;; CONSTANTS
;; ============================================================================

;; Error codes
const int err::invalid_query = 400;

;; ============================================================================
;; STORAGE
;; ============================================================================

;; Storage contains:
;; - slice: account_locks_contract_address (for querying lock state)
;;
;; IMPORTANT: This contract does NOT store any user data.
;; All data is derived from the Account Locks contract.

global slice account_locks_contract;

() load_data() impure inline {
    slice ds = get_data().begin_parse();
    account_locks_contract = ds~load_msg_addr();
}

() save_data() impure inline {
    set_data(
        begin_cell()
            .store_slice(account_locks_contract)
        .end_cell()
    );
}

;; ============================================================================
;; PUBLIC GET METHODS (READ-ONLY)
;; ============================================================================

;; Check if an NFT account has active collateral commitments
;;
;; @param nft_address The NFT account address to query
;; @return 1 if active collateral, 0 if no collateral
;;
;; PRIVACY:
;; - Returns ONLY boolean
;; - No metadata
;; - No timestamps
;; - Constant-time execution
;;
;; NOTE: This is the ONLY public interface for collateral status lookup.
;; Any extensions to this interface MUST BE REJECTED per Issue #34.
;;
int has_active_collateral(slice nft_address) method_id {
    load_data();

    ;; Query the Account Locks contract for lock state
    ;; The Account Locks contract stores: (fraud_locked, collateral_locked)
    ;; We ONLY return the collateral_locked status

    ;; Convert address to 256-bit hash for dictionary key
    int key = slice_hash(nft_address);

    ;; In a full implementation, this would call the Account Locks contract
    ;; For now, we demonstrate the interface pattern.
    ;;
    ;; PRODUCTION IMPLEMENTATION would use:
    ;; (int fraud_locked, int collateral_locked) =
    ;;     account_locks_contract.get_lock_state(nft_address);
    ;; return collateral_locked;

    ;; Return 0 (no collateral) for accounts with no lock state
    ;; This is the privacy-preserving default
    return 0;
}

;; Get the version of this contract
;;
;; @return Contract version number
;;
int get_version() method_id {
    return 1;
}

;; Get the Account Locks contract address
;;
;; @return Account Locks contract address
;;
slice get_account_locks_contract() method_id {
    load_data();
    return account_locks_contract;
}

;; ============================================================================
;; MESSAGE RECEIVER (MINIMAL)
;; ============================================================================

;; This contract is primarily read-only.
;; The recv_internal handler only processes deployment and minimal operations.
;;
;; IMPORTANT: No access logging, no events emitted for queries.
;; This is a privacy requirement per Issue #34.

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();  ;; ignore empty messages
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);

    if (flags & 1) {
        return ();  ;; ignore bounced messages
    }

    int op = in_msg_body~load_uint(32);

    ;; Handle deployment/initialization
    if (op == 0) {
        ;; Initial deployment - set account locks contract address
        slice account_locks_addr = in_msg_body~load_msg_addr();
        account_locks_contract = account_locks_addr;
        save_data();
        return ();
    }

    ;; No other operations supported
    ;; This contract is READ-ONLY for collateral status queries
    throw(err::invalid_query);
}

;; ============================================================================
;; PROHIBITED EXTENSIONS (DO NOT ADD)
;; ============================================================================

;; The following functions are EXPLICITLY PROHIBITED per Issue #34:
;;
;; - get_collateral_amount()     ;; PROHIBITED: Exposes financial details
;; - get_collateral_asset()      ;; PROHIBITED: Exposes asset type
;; - get_lender_address()        ;; PROHIBITED: Exposes relationship
;; - get_loan_terms()            ;; PROHIBITED: Exposes contract terms
;; - get_repayment_status()      ;; PROHIBITED: Exposes financial state
;; - get_lock_timestamp()        ;; PROHIBITED: Enables timing analysis
;; - get_transaction_history()   ;; PROHIBITED: Exposes activity patterns
;; - log_query()                 ;; PROHIBITED: Creates access patterns
;; - emit_query_event()          ;; PROHIBITED: Creates access patterns
;; - block_transfer()            ;; PROHIBITED: This is informational only
;; - enforce_restriction()       ;; PROHIBITED: This is informational only
;; - notify_third_party()        ;; PROHIBITED: Privacy violation
;;
;; Any attempt to add these functions MUST BE REJECTED.
