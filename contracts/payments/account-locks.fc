;; Account Locks Smart Contract
;; Part of Tonbankcard Payment Hub
;; Issue #96: Two-phase role transfer with 7-day timelock for risk_authority and lending_adapter
;;
;; Implements lock mechanism for NFT accounts to:
;; - Block fraudulent accounts (FRAUD_LOCK)
;; - Lock collateralized accounts (COLLATERAL_LOCK)
;; - Maintain non-custodial architecture (locks are flags, not custody)
;;
;; PROTOCOL INVARIANTS (see docs/invariants.md):
;; - I3 (No Admin Control): risk_authority and lending_adapter can ONLY set locks, NOT move funds
;;   Role transfer uses a 7-day timelock (propose + execute pattern)
;; - I6 (Lock ≠ Confiscation): Locks restrict sending, NOT ownership or balance
;;   * can_send() returns 0 when locked
;;   * can_receive() ALWAYS returns 1
;;   * Lock operations do NOT modify balances
;; - I7 (Adapter Isolation): External adapters cannot bypass protocol rules

#include "stdlib.fc";

;; Lock type constants
const int LOCK_NONE = 0;
const int FRAUD_LOCK = 1;
const int COLLATERAL_LOCK = 2;
const int READ_ONLY = 4;  ;; future-proof

;; Operation codes
const int op::set_fraud_lock = 0x1001;
const int op::clear_fraud_lock = 0x1002;
const int op::set_collateral_lock = 0x1003;
const int op::clear_collateral_lock = 0x1004;
const int op::check_can_send = 0x2001;
const int op::get_lock_state = 0x3001;

;; Role transfer operation codes (Issue #96: two-phase transfer with 7-day timelock)
;; risk_authority role transfer
const int op::propose_risk_authority = 0x4001;
const int op::execute_risk_authority = 0x4002;
const int op::cancel_risk_authority = 0x4003;
;; lending_adapter role transfer
const int op::propose_lending_adapter = 0x4011;
const int op::execute_lending_adapter = 0x4012;
const int op::cancel_lending_adapter = 0x4013;

;; Exit codes
const int err::unauthorized = 401;
const int err::account_locked = 403;
const int err::invalid_nft = 404;
const int err::invalid_operation = 400;
const int err::no_pending_transfer = 405;
const int err::timelock_not_expired = 406;

;; Timelock delay: 7 days in seconds
const int ROLE_TRANSFER_DELAY = 7 * 24 * 60 * 60;

;; Storage structure
;; cell storage contains:
;; - dict: nft_address -> (fraud_locked, collateral_locked)
;; - slice: risk_authority_address
;; - slice: lending_adapter_address
;; - int: pending_risk_authority_present (0 or 1)
;; - slice: pending_risk_authority_address (only valid if pending_risk_authority_present == 1)
;; - int: pending_risk_authority_executable_at (unix timestamp)
;; - int: pending_lending_adapter_present (0 or 1)
;; - slice: pending_lending_adapter_address (only valid if pending_lending_adapter_present == 1)
;; - int: pending_lending_adapter_executable_at (unix timestamp)

(cell, slice, slice, int, slice, int, int, slice, int) load_data() inline {
    slice ds = get_data().begin_parse();
    cell lock_dict = ds~load_dict();
    slice risk_authority = ds~load_msg_addr();
    slice lending_adapter = ds~load_msg_addr();
    int pending_risk_present = ds~load_uint(1);
    slice pending_risk = ds~load_msg_addr();
    int pending_risk_at = ds~load_uint(32);
    int pending_lending_present = ds~load_uint(1);
    slice pending_lending = ds~load_msg_addr();
    int pending_lending_at = ds~load_uint(32);
    return (lock_dict, risk_authority, lending_adapter,
            pending_risk_present, pending_risk, pending_risk_at,
            pending_lending_present, pending_lending, pending_lending_at);
}

() save_data(cell lock_dict, slice risk_authority, slice lending_adapter,
             int pending_risk_present, slice pending_risk, int pending_risk_at,
             int pending_lending_present, slice pending_lending, int pending_lending_at) impure inline {
    set_data(
        begin_cell()
            .store_dict(lock_dict)
            .store_slice(risk_authority)
            .store_slice(lending_adapter)
            .store_uint(pending_risk_present, 1)
            .store_slice(pending_risk)
            .store_uint(pending_risk_at, 32)
            .store_uint(pending_lending_present, 1)
            .store_slice(pending_lending)
            .store_uint(pending_lending_at, 32)
        .end_cell()
    );
}

;; Get lock state for an NFT account
;; Returns (fraud_locked: int, collateral_locked: int)
(int, int) get_lock_state(slice nft_address) method_id {
    (cell lock_dict, _, _, _, _, _, _, _, _) = load_data();

    ;; Convert address to 256-bit hash for dictionary key
    int key = slice_hash(nft_address);

    (slice value, int found) = lock_dict.udict_get?(256, key);

    if (found) {
        int fraud_locked = value~load_uint(1);
        int collateral_locked = value~load_uint(1);
        return (fraud_locked, collateral_locked);
    }

    ;; Account not locked
    return (0, 0);
}

;; Check if account is locked (any lock type)
int is_account_locked(slice nft_address) method_id {
    (int fraud_locked, int collateral_locked) = get_lock_state(nft_address);
    return fraud_locked | collateral_locked;
}

;; Check if account can send TBC
;; Returns 1 if can send, 0 if locked
int can_send(slice nft_address) method_id {
    (int fraud_locked, int collateral_locked) = get_lock_state(nft_address);

    ;; Cannot send if either fraud_locked or collateral_locked
    if (fraud_locked | collateral_locked) {
        return 0;
    }

    return 1;
}

;; Check if account can receive TBC
;; INVARIANT I6: Always returns 1 (receiving is ALWAYS allowed, locks don't confiscate)
int can_receive(slice nft_address) method_id {
    return 1;  ;; INVARIANT I6: RECEIVE operations are always allowed even when locked
}

;; Set lock state for an NFT account
;; INVARIANT I6: This function ONLY sets lock flags, does NOT modify balances or ownership
() set_lock(cell lock_dict, slice nft_address, int fraud_locked, int collateral_locked) impure inline {
    int key = slice_hash(nft_address);

    cell value = begin_cell()
        .store_uint(fraud_locked, 1)
        .store_uint(collateral_locked, 1)
    .end_cell();

    lock_dict~udict_set(256, key, value.begin_parse());
}

;; Emit AccountLocked event
() emit_account_locked(slice nft_address, int lock_type) impure inline {
    var msg = begin_cell()
        .store_uint(0x18, 6)  ;; nobounce
        .store_slice(nft_address)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(0x4c6f636b, 32)  ;; "Lock" marker
        .store_uint(lock_type, 8)
    .end_cell();

    send_raw_message(msg, 64);  ;; carry remaining value
}

;; Emit AccountUnlocked event
() emit_account_unlocked(slice nft_address, int lock_type) impure inline {
    var msg = begin_cell()
        .store_uint(0x18, 6)  ;; nobounce
        .store_slice(nft_address)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(0x556e6c6b, 32)  ;; "Unlk" marker
        .store_uint(lock_type, 8)
    .end_cell();

    send_raw_message(msg, 64);  ;; carry remaining value
}

;; Main message receiver
() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();  ;; ignore empty messages
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);

    if (flags & 1) {
        return ();  ;; ignore bounced messages
    }

    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);

    (cell lock_dict, slice risk_authority, slice lending_adapter,
     int pending_risk_present, slice pending_risk, int pending_risk_at,
     int pending_lending_present, slice pending_lending, int pending_lending_at) = load_data();

    ;; Set FRAUD_LOCK
    if (op == op::set_fraud_lock) {
        ;; INVARIANT I3: Only risk authority can set fraud lock (no fund control)
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, risk_authority));

        slice nft_address = in_msg_body~load_msg_addr();
        (int fraud_locked, int collateral_locked) = get_lock_state(nft_address);

        set_lock(lock_dict, nft_address, 1, collateral_locked);
        save_data(lock_dict, risk_authority, lending_adapter,
                  pending_risk_present, pending_risk, pending_risk_at,
                  pending_lending_present, pending_lending, pending_lending_at);

        emit_account_locked(nft_address, FRAUD_LOCK);
        return ();
    }

    ;; Clear FRAUD_LOCK
    if (op == op::clear_fraud_lock) {
        ;; Only risk authority can clear fraud lock
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, risk_authority));

        slice nft_address = in_msg_body~load_msg_addr();
        (int fraud_locked, int collateral_locked) = get_lock_state(nft_address);

        set_lock(lock_dict, nft_address, 0, collateral_locked);
        save_data(lock_dict, risk_authority, lending_adapter,
                  pending_risk_present, pending_risk, pending_risk_at,
                  pending_lending_present, pending_lending, pending_lending_at);

        emit_account_unlocked(nft_address, FRAUD_LOCK);
        return ();
    }

    ;; Set COLLATERAL_LOCK
    if (op == op::set_collateral_lock) {
        ;; Only lending adapter can set collateral lock
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, lending_adapter));

        slice nft_address = in_msg_body~load_msg_addr();
        (int fraud_locked, int collateral_locked) = get_lock_state(nft_address);

        set_lock(lock_dict, nft_address, fraud_locked, 1);
        save_data(lock_dict, risk_authority, lending_adapter,
                  pending_risk_present, pending_risk, pending_risk_at,
                  pending_lending_present, pending_lending, pending_lending_at);

        emit_account_locked(nft_address, COLLATERAL_LOCK);
        return ();
    }

    ;; Clear COLLATERAL_LOCK
    if (op == op::clear_collateral_lock) {
        ;; Only lending adapter can clear collateral lock
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, lending_adapter));

        slice nft_address = in_msg_body~load_msg_addr();
        (int fraud_locked, int collateral_locked) = get_lock_state(nft_address);

        set_lock(lock_dict, nft_address, fraud_locked, 0);
        save_data(lock_dict, risk_authority, lending_adapter,
                  pending_risk_present, pending_risk, pending_risk_at,
                  pending_lending_present, pending_lending, pending_lending_at);

        emit_account_unlocked(nft_address, COLLATERAL_LOCK);
        return ();
    }

    ;; Check if account can send (used by Payment Hub before SEND operations)
    if (op == op::check_can_send) {
        slice nft_address = in_msg_body~load_msg_addr();
        int can_send_flag = can_send(nft_address);

        ;; Throw if account is locked
        throw_unless(err::account_locked, can_send_flag);

        return ();
    }

    ;; ========================================================
    ;; ROLE TRANSFER: risk_authority (Issue #96, two-phase + 7-day timelock)
    ;; ========================================================

    ;; Phase 1: Current risk_authority proposes a new risk_authority
    if (op == op::propose_risk_authority) {
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, risk_authority));
        slice proposed = in_msg_body~load_msg_addr();
        int executable_at = now() + ROLE_TRANSFER_DELAY;
        save_data(lock_dict, risk_authority, lending_adapter,
                  1, proposed, executable_at,
                  pending_lending_present, pending_lending, pending_lending_at);
        return ();
    }

    ;; Phase 2: Proposed risk_authority executes the transfer (after timelock)
    if (op == op::execute_risk_authority) {
        throw_unless(err::no_pending_transfer, pending_risk_present);
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, pending_risk));
        throw_unless(err::timelock_not_expired, now() >= pending_risk_at);
        save_data(lock_dict, pending_risk, lending_adapter,
                  0, pending_risk, 0,
                  pending_lending_present, pending_lending, pending_lending_at);
        return ();
    }

    ;; Cancel a pending risk_authority transfer (only current risk_authority)
    if (op == op::cancel_risk_authority) {
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, risk_authority));
        throw_unless(err::no_pending_transfer, pending_risk_present);
        save_data(lock_dict, risk_authority, lending_adapter,
                  0, risk_authority, 0,
                  pending_lending_present, pending_lending, pending_lending_at);
        return ();
    }

    ;; ========================================================
    ;; ROLE TRANSFER: lending_adapter (Issue #96, two-phase + 7-day timelock)
    ;; ========================================================

    ;; Phase 1: Current lending_adapter proposes a new lending_adapter
    if (op == op::propose_lending_adapter) {
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, lending_adapter));
        slice proposed = in_msg_body~load_msg_addr();
        int executable_at = now() + ROLE_TRANSFER_DELAY;
        save_data(lock_dict, risk_authority, lending_adapter,
                  pending_risk_present, pending_risk, pending_risk_at,
                  1, proposed, executable_at);
        return ();
    }

    ;; Phase 2: Proposed lending_adapter executes the transfer (after timelock)
    if (op == op::execute_lending_adapter) {
        throw_unless(err::no_pending_transfer, pending_lending_present);
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, pending_lending));
        throw_unless(err::timelock_not_expired, now() >= pending_lending_at);
        save_data(lock_dict, risk_authority, pending_lending,
                  pending_risk_present, pending_risk, pending_risk_at,
                  0, pending_lending, 0);
        return ();
    }

    ;; Cancel a pending lending_adapter transfer (only current lending_adapter)
    if (op == op::cancel_lending_adapter) {
        throw_unless(err::unauthorized, equal_slice_bits(sender_address, lending_adapter));
        throw_unless(err::no_pending_transfer, pending_lending_present);
        save_data(lock_dict, risk_authority, lending_adapter,
                  pending_risk_present, pending_risk, pending_risk_at,
                  0, lending_adapter, 0);
        return ();
    }

    ;; Unknown operation
    throw(err::invalid_operation);
}

;; Get methods for public interface

;; Get lock state for NFT account
;; Returns tuple (fraud_locked, collateral_locked)
(int, int) get_account_lock_state(slice nft_address) method_id {
    return get_lock_state(nft_address);
}

;; Check if account has any active lock
int get_is_account_locked(slice nft_address) method_id {
    return is_account_locked(nft_address);
}

;; Check if account can send TBC
int get_can_send(slice nft_address) method_id {
    return can_send(nft_address);
}

;; Check if account can receive TBC
int get_can_receive(slice nft_address) method_id {
    return can_receive(nft_address);
}

;; Get contract version
int get_version() method_id {
    return 2;  ;; bumped for Issue #96: role transfer support
}

;; Get current risk_authority address
slice get_risk_authority() method_id {
    (_, slice risk_authority, _, _, _, _, _, _, _) = load_data();
    return risk_authority;
}

;; Get current lending_adapter address
slice get_lending_adapter() method_id {
    (_, _, slice lending_adapter, _, _, _, _, _, _) = load_data();
    return lending_adapter;
}

;; Get pending risk_authority transfer info
;; Returns (pending_present: int, pending_address: slice, executable_at: int)
(int, slice, int) get_pending_risk_authority() method_id {
    (_, _, _, int pending_present, slice pending_addr, int executable_at, _, _, _) = load_data();
    return (pending_present, pending_addr, executable_at);
}

;; Get pending lending_adapter transfer info
;; Returns (pending_present: int, pending_address: slice, executable_at: int)
(int, slice, int) get_pending_lending_adapter() method_id {
    (_, _, _, _, _, _, int pending_present, slice pending_addr, int executable_at) = load_data();
    return (pending_present, pending_addr, executable_at);
}
