# Dependencies
node_modules/

# Build output
dist/
build/

# Test coverage reports (regenerated by `npm run test:coverage`)
coverage/

# Lock files
# package-lock.json is tracked in every npm workspace so that `npm ci`
# yields a reproducible, audit-verifiable install. See
# docs/security/DEPENDENCY_AUDIT.md and issue #131.
yarn.lock

# Logs
*.log
ci-logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
# Ignore every secret-bearing .env file (e.g. .env.sandbox, .env.local,
# .env.production.local) but keep the tracked *.example templates. See issue #261.
.env
.env.*
!.env.example
!.env.*.example

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Playwright MCP local artefacts (snapshots, console logs)
.playwright-mcp/
