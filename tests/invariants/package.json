{
  "name": "@tonbankcard/invariants",
  "version": "0.1.0",
  "private": true,
  "description": "Executable model and property-based tests for TONBANKCARD protocol invariants I1–I7",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/property/*.spec.ts"
    ],
    "testTimeout": 60000
  }
}
