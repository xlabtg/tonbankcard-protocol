{
  "name": "@tonbankcard/adversarial-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Adversarial security and fuzz tests for TONBANKCARD protocol entry points (D1)",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/scenarios/*.spec.ts",
      "**/fuzz/*.spec.ts"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "model/**/*.ts",
      "!model/**/*.spec.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
