{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": [
    "model/**/*.ts",
    "scenarios/**/*.ts",
    "fuzz/**/*.ts"
  ]
}
