{
  "name": "@tonbankcard/wallet-ui",
  "version": "1.0.0",
  "description": "Non-custodial Wallet UI for TONBANKCARD protocol - read-only presentational interface",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "wallet",
    "ui",
    "non-custodial",
    "tbc",
    "presentational"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlabtg/tonbankcard-protocol.git",
    "directory": "wallet-ui"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": ">=13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/ton": ">=13.0.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "handlebars": "^4.7.9",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "picomatch": "^2.3.2",
    "rollup": "^4.60.4",
    "ajv": "^6.15.0",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "undici": "^7.28.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
