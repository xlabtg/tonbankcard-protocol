# Public testnet configuration for the React example.
# Copy to .env.local and customise as needed. All values are public; never put
# secrets (API keys, mnemonics) into the example.

# Merchant NFT address on testnet. Defaults to the sandbox merchant NFT
# documented in docs/sandbox.md so the example works against the public
# Tonbankcard sandbox out of the box. Replace with your own merchant NFT once
# you start integration testing your business logic.
VITE_MERCHANT_NFT=EQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Sandbox API base URL. Used to display the merchant API endpoint in the demo
# UI and to call `GET /v1/sandbox/info` for discovery. See docs/sandbox.md.
VITE_MERCHANT_API_BASE=https://sandbox.api.tonbankcard.com

# Sandbox faucet URL. The demo surfaces a link so users can mint test TBC
# before paying an invoice.
VITE_FAUCET_URL=https://sandbox.api.tonbankcard.com/faucet

# Optional Payment Hub override (defaults to TESTNET_CONFIG from the SDK).
# Leave unset to use the public testnet hub once deployed.
# VITE_PAYMENT_HUB=EQ...

# Optional RPC override (defaults to https://testnet.toncenter.com/api/v2/jsonRPC).
# VITE_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
