# Public testnet configuration for the React example.
# Copy to .env.local and customise as needed. All values are public; never put
# secrets (API keys, mnemonics) into the example.

# Merchant NFT address on testnet. Replace with your own to test against your
# Payment Hub deployment. The default value is a placeholder.
VITE_MERCHANT_NFT=EQAjHkHtt1MIoU5c7dks73Rz8NMxAA3oStSrcQ_qgn3il-Le

# Optional Payment Hub override (defaults to TESTNET_CONFIG from the SDK).
# Leave unset to use the public testnet hub once deployed.
# VITE_PAYMENT_HUB=EQ...

# Optional RPC override (defaults to https://testnet.toncenter.com/api/v2/jsonRPC).
# VITE_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
