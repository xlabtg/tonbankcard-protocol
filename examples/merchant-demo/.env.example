# =============================================================================
# examples/merchant-demo — environment overrides
# =============================================================================
#
# The demo runs with NO environment variables against the public C3 sandbox.
# Copy this file to `.env` ONLY if you need to override one of the defaults
# below (e.g. to point at a local sandbox stack).
#
# NEVER commit a populated `.env` file. The repo's root `.gitignore`
# excludes it, but treat secrets with the same paranoia regardless.

# HTTP port the demo listens on.
PORT=8080

# Upstream Merchant API base URL. Override to your own sandbox or
# `http://localhost:3001` when you run `docker-compose.sandbox.yml` locally.
SANDBOX_API_URL=https://sandbox.api.tonbankcard.com

# Default recipient merchant NFT (testnet). Replace with your own testnet card.
SANDBOX_MERCHANT_NFT=EQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Default checkout amount in decimal TBC (the bagel preset).
SANDBOX_DEFAULT_AMOUNT_TBC=1.50

# Set to `1` to skip the sandbox API call entirely (offline / CI mode).
# DEMO_DISABLE_REMOTE=1
