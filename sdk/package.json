{
  "name": "@tonbankcard/merchant-sdk",
  "version": "1.1.0",
  "description": "Non-custodial Merchant SDK for TONBANKCARD payments integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "merchant",
    "payments",
    "sdk",
    "non-custodial",
    "tbc"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlabtg/tonbankcard-protocol.git",
    "directory": "sdk"
  },
  "dependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/crypto": "^3.2.0",
    "@ton/ton": ">=13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.11",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/ton": ">=13.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
