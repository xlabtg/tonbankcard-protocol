{
  "name": "@tonbankcard/merchant-sdk",
  "version": "1.1.0",
  "description": "Non-custodial Merchant SDK for TONBANKCARD payments integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "merchant",
    "payments",
    "sdk",
    "non-custodial",
    "tbc"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlabtg/tonbankcard-protocol.git",
    "directory": "sdk"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/ton": "13.11.2"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/jsdom": "28.0.3",
    "@types/node": "20.19.41",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "ts-jest": "29.4.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/ton": ">=13.0.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "handlebars": "^4.7.9",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "picomatch": "^2.3.2",
    "rollup": "^4.60.4",
    "ajv": "^6.15.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
