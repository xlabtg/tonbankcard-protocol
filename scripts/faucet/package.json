{
  "name": "@tonbankcard/tbc-faucet",
  "version": "1.0.0",
  "description": "TBC faucet for the Tonbankcard testnet sandbox \u2014 dispenses test TBC tokens to integrators",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tonbankcard",
    "faucet",
    "tbc",
    "testnet",
    "sandbox"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "cors": "^2.8.5",
    "@ton/core": "^0.63.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@jest/globals": "^30.5.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "@types/supertest": "^7.2.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
