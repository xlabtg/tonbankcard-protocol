{
  "name": "@tonbankcard/mobile-core",
  "version": "1.0.0",
  "description": "Platform-agnostic core logic layer for TONBANKCARD mobile applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "mobile",
    "payments",
    "non-custodial",
    "tbc"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlabtg/tonbankcard-protocol.git",
    "directory": "mobile"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": ">=13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@ton/core": ">=0.56.0",
    "@ton/ton": ">=13.0.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "handlebars": "^4.7.9",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "picomatch": "^2.3.2",
    "rollup": "^4.60.4",
    "ajv": "^6.15.0",
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.6",
    "form-data": "^4.0.6"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.spec.ts"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
