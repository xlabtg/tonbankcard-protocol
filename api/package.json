{
  "name": "@tonbankcard/merchant-api",
  "version": "1.0.0",
  "description": "Non-custodial Merchant API for TONBANKCARD payment infrastructure",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "ton",
    "tonbankcard",
    "merchant",
    "api",
    "payments",
    "non-custodial",
    "tbc"
  ],
  "author": "Tonbankcard Protocol Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xlabtg/tonbankcard-protocol.git",
    "directory": "api"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.4.1",
    "helmet": "7.2.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "axios": "^1.16.1",
    "handlebars": "^4.7.9",
    "minimatch": "^9.0.7",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "follow-redirects": "^1.16.0",
    "picomatch": "^2.3.2",
    "ajv": "^6.15.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
