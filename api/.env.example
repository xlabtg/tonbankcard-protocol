# =============================================================================
# Tonbankcard Merchant API — example environment file
# =============================================================================
#
# Copy this file to api/.env and replace placeholder values. Real secrets MUST
# NEVER be committed; the project root .gitignore excludes every .env file.
#
# When running via docker compose, variables from this file are loaded for the
# `api` service together with the project-root .env (see docker-compose.yml).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins for the merchant dashboard.
# Use a single "*" only in non-production environments.
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret (HMAC key) used to hash API keys issued to merchants. Generate a
# fresh value with `openssl rand -hex 32` and rotate periodically.
# REQUIRED: outside of tests the API refuses to start if this is unset, empty,
# shorter than 16 characters, or left as a known placeholder/default value
# (including the value below) — see audit finding API-H1.
API_KEY_SECRET=change-me-to-a-32-byte-random-value

# Bootstrap token that authorises the `/v1/keys` management endpoints.
# Leave unset to fully disable programmatic key issuance and revocation
# (the endpoints will respond with 403). Generate with `openssl rand -hex 48`.
# API_KEY_ADMIN_TOKEN=change-me-to-a-long-random-secret

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Window applied to every limiter, in milliseconds (default: 60 000 = 1 min).
# RATE_LIMIT_WINDOW_MS=60000

# Per-API-key cap for POST /v1/invoice/create (default: 60 rpm).
# RATE_LIMIT_INVOICE_CREATE_PER_MIN=60

# Per-API-key cap for GET /v1/invoice/:id/status (default: 300 rpm).
# RATE_LIMIT_INVOICE_STATUS_PER_MIN=300

# Per-API-key cap for authenticated invoice reads (default: 1000 rpm).
# RATE_LIMIT_INVOICE_READ_PER_MIN=1000

# Per-IP cap for unauthenticated routes including key issuance (default: 10 rpm).
# RATE_LIMIT_PUBLIC_PER_MIN=10

# ---------------------------------------------------------------------------
# Webhook delivery
# ---------------------------------------------------------------------------
# Default signing secret used when a registered webhook endpoint does not
# carry its own per-merchant secret. Generate with `openssl rand -hex 32`.
# WEBHOOK_SIGNING_SECRET=change-me-to-a-32-byte-random-value

# ---------------------------------------------------------------------------
# Storage (PostgresStorage backend — optional)
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to fall back to the in-memory storage used by
# default in development. For production deployments behind multiple replicas
# you MUST set DATABASE_URL (or the discrete POSTGRES_* variables below).
# DATABASE_URL=postgres://tonbankcard:tonbankcard@postgres:5432/tonbankcard
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=tonbankcard
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=tonbankcard
# POSTGRES_POOL_MIN=2
# POSTGRES_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis idempotency storage (optional)
# ---------------------------------------------------------------------------
# When set, the API stores idempotency keys in Redis so deduplication works
# across horizontally scaled replicas.
# REDIS_URL=redis://redis:6379/0
